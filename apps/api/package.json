{
  "name": "@buildview/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --env-file-if-exists=../../.env ../../node_modules/vitest/vitest.mjs run",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "node --env-file-if-exists=../../.env ../../node_modules/prisma/build/index.js migrate deploy --schema prisma/schema.prisma",
    "db:migrate:dev": "node --env-file-if-exists=../../.env ../../node_modules/prisma/build/index.js migrate dev --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@buildview/design-engine": "*",
    "@buildview/geometry-engine": "*",
    "@buildview/shared": "*",
    "@fastify/cors": "^11.0.0",
    "@prisma/client": "^6.19.3",
    "fastify": "^5.6.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "tsx": "^4.20.0",
    "vitest": "^3.2.7"
  }
}
