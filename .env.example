# PostgreSQL connection used by the API (Prisma). `npm run db:up` starts a local
# embedded PostgreSQL on this port with this user/password/database.
DATABASE_URL="postgresql://buildview:buildview@localhost:54329/buildview?schema=public"

# API
API_PORT=4000
# "postgres" (default when DATABASE_URL is set) or "memory" (labelled local dev mode, NOT persistent)
STORAGE=postgres

# CAD import
# Python worker (FastAPI + ezdxf). Start with `npm run worker` after `npm run worker:setup`.
CAD_WORKER_URL=http://127.0.0.1:8100
# Private storage for uploaded originals (never served statically). Defaults to ../../.data/uploads
# UPLOAD_DIR=
MAX_UPLOAD_BYTES=26214400
# DWG needs a licensed DWG->DXF converter (e.g. Open Design Alliance File Converter). Leave unset
# unless you have one installed and licensed; DWG uploads are then reported as unavailable.
# DWG_CONVERTER=
