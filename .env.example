# PostgreSQL connection used by the API (Prisma). `npm run db:up` starts a local
# embedded PostgreSQL on this port with this user/password/database.
DATABASE_URL="postgresql://buildview:buildview@localhost:54329/buildview?schema=public"

# API
API_PORT=4000
# "postgres" (default when DATABASE_URL is set) or "memory" (labelled local dev mode, NOT persistent)
STORAGE=postgres
